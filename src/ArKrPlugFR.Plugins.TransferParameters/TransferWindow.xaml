<Window x:Class="ArKrPlugFR.Plugins.TransferParameters.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="880"
        Height="660"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArKrPlugFR.Ui;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Tab headers of the tool; the theme carries no tabs because this is the
                 only window with them. -->
            <Style x:Key="ToolTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Root"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,0,0,2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ReceiverCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource TitleText}" Text="{Binding WindowTitle}" />
            <TextBlock Style="{DynamicResource CaptionText}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">

            <!-- Tab 1: one value onto the ticked sheets. -->
            <TabItem Header="{Binding TabSheets}" Style="{StaticResource ToolTab}">
                <Grid Margin="2,12,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Content="{Binding PickSourceText}"
                                Click="OnPickSourceClick" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding SourceLine}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{DynamicResource CaptionText}" Text="{Binding SourceParameterCaption}" />
                            <ComboBox Margin="0,4,0,0"
                                      ItemsSource="{Binding SourceParameterNames}"
                                      SelectedItem="{Binding SelectedSourceParameter, Mode=TwoWay}" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{DynamicResource CaptionText}"
                                       Text="{Binding ValueCaption}" />
                            <TextBox Margin="0,4,0,0"
                                     Style="{DynamicResource FieldTextBox}"
                                     IsReadOnly="True"
                                     Text="{Binding SourceValue, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{DynamicResource CaptionText}" Text="{Binding TargetParameterCaption}" />
                            <ComboBox Margin="0,4,0,0"
                                      ItemsSource="{Binding TargetParameterNames}"
                                      SelectedItem="{Binding SelectedTargetParameter, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,10,0,0"
                            Padding="10"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{DynamicResource CaptionText}"
                                           Text="{Binding SheetsCaption}" />
                                <TextBlock Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{DynamicResource CaptionText}"
                                           Text="{Binding SheetsLine}" />
                                <Button Margin="14,0,0,0"
                                        Style="{DynamicResource SecondaryButton}"
                                        Content="{Binding SelectAllText}"
                                        Click="OnSelectAllSheetsClick" />
                                <Button Margin="8,0,0,0"
                                        Style="{DynamicResource SecondaryButton}"
                                        Content="{Binding ClearSelectionText}"
                                        Click="OnClearSheetsClick" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding SheetRows}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Number}" />
                                                <TextBlock Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Name}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right"
                                Style="{DynamicResource PrimaryButton}"
                                Content="{Binding ApplyText}"
                                Click="OnApplySheetsClick" />
                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding SheetsHint}" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: the layer structure of walls and floors into a parameter. -->
            <TabItem Header="{Binding TabStructures}" Style="{StaticResource ToolTab}">
                <Grid Margin="2,12,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Content="{Binding PickStructuresText}"
                                Click="OnPickStructuresClick" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionText}"
                                   Text="{Binding StructuresLine}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Style="{DynamicResource CaptionText}" Text="{Binding ParameterNameCaption}" />
                        <TextBox Width="280"
                                 Margin="0,4,0,0"
                                 HorizontalAlignment="Left"
                                 Style="{DynamicResource FieldTextBox}"
                                 Text="{Binding StructureParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Margin="0,8,0,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Content="{Binding WriteToTypeCaption}"
                                  IsChecked="{Binding WriteToType, Mode=TwoWay}" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Margin="0,10,0,0"
                            Padding="10"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,6"
                                       Style="{DynamicResource CaptionText}"
                                       Text="{Binding ElementsCaption}" />

                            <ListBox ItemsSource="{Binding StructureRows}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right"
                                Style="{DynamicResource PrimaryButton}"
                                Content="{Binding ApplyText}"
                                Click="OnApplyStructuresClick" />
                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding StructuresHint}" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Tab 3: the value of a room onto the structures around it. -->
            <TabItem Header="{Binding TabRooms}" Style="{StaticResource ToolTab}">
                <Grid Margin="2,12,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Content="{Binding PickRoomsText}"
                                Click="OnPickRoomsClick" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionText}"
                                   Text="{Binding RoomsLine}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{DynamicResource CaptionText}" Text="{Binding SourceParameterCaption}" />
                            <ComboBox Margin="0,4,0,0"
                                      ItemsSource="{Binding RoomSourceParameterNames}"
                                      SelectedItem="{Binding SelectedRoomSourceParameter, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{DynamicResource CaptionText}" Text="{Binding TargetParameterCaption}" />
                            <TextBox Margin="0,4,0,0"
                                     Style="{DynamicResource FieldTextBox}"
                                     Text="{Binding RoomTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
                        <CheckBox Style="{StaticResource ReceiverCheck}"
                                  Content="{Binding ReceiverWallsText}"
                                  IsChecked="{Binding ReceiverWalls, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource ReceiverCheck}"
                                  Content="{Binding ReceiverFloorsText}"
                                  IsChecked="{Binding ReceiverFloors, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource ReceiverCheck}"
                                  Content="{Binding ReceiverCeilingsText}"
                                  IsChecked="{Binding ReceiverCeilings, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource ReceiverCheck}"
                                  Content="{Binding ReceiverRoomsText}"
                                  IsChecked="{Binding ReceiverRooms, Mode=TwoWay}" />
                    </StackPanel>

                    <Border Grid.Row="3"
                            Margin="0,10,0,0"
                            Padding="10"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,6"
                                       Style="{DynamicResource CaptionText}"
                                       Text="{Binding RoomsCaption}" />

                            <ListBox ItemsSource="{Binding RoomRows}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Row="4" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right"
                                Style="{DynamicResource PrimaryButton}"
                                Content="{Binding ApplyText}"
                                Click="OnApplyRoomsClick" />
                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding RoomsHint}" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,6"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding ReportCaption}" />
                <TextBox Style="{DynamicResource ReportTextBox}"
                         MinHeight="64"
                         MaxHeight="150"
                         Text="{Binding Report, Mode=OneWay}" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{DynamicResource SecondaryButton}"
                    Content="{Binding Text.Close}"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
