<Window x:Class="ArKrPlugFR.Plugins.DuplicateViews.DuplicateViewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1000"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArKrPlugFR.Ui;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="CountButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="24" />
                <Setter Property="Padding" Value="5,1" />
            </Style>

            <Style x:Key="TreeNode" TargetType="CheckBox">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource TitleText}"
                       Text="{Binding WindowTitle}" />
            <TextBlock Style="{DynamicResource CaptionText}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBox DockPanel.Dock="Left"
                     Width="240"
                     Style="{DynamicResource FieldTextBox}"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Style="{DynamicResource CaptionText}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding TreeHint}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="10"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding ViewsHeader}" />
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               TextWrapping="Wrap"
                               Text="{Binding Text.SearchHint}"
                               Visibility="{Binding HasNoVisibleViews, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Views}"
                                      PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <CheckBox Margin="0,5,0,2"
                                                  IsThreeState="True"
                                                  Style="{StaticResource TreeNode}"
                                                  IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                  Content="{Binding DisplayName}" />
                                        <ItemsControl ItemsSource="{Binding Children}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="16,1,0,1"
                                                          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  Style="{StaticResource TreeNode}"
                                                                  IsChecked="{Binding IsChecked, Mode=OneWay}">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </CheckBox>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Style="{StaticResource CountButton}"
                                                                    Content="&#x2212;"
                                                                    Click="OnDecreaseClick" />
                                                            <TextBox Width="36"
                                                                     Margin="4,0"
                                                                     TextAlignment="Center"
                                                                     Style="{DynamicResource FieldTextBox}"
                                                                     Text="{Binding CountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button Style="{StaticResource CountButton}"
                                                                    Content="+"
                                                                    Click="OnIncreaseClick" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="10"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding SchedulesHeader}" />
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               TextWrapping="Wrap"
                               Text="{Binding Text.SearchHint}"
                               Visibility="{Binding HasNoVisibleSchedules, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Schedules}"
                                      PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <CheckBox Margin="0,5,0,2"
                                                  IsThreeState="True"
                                                  Style="{StaticResource TreeNode}"
                                                  IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                  Content="{Binding DisplayName}" />
                                        <ItemsControl ItemsSource="{Binding Children}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="16,1,0,1"
                                                          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  Style="{StaticResource TreeNode}"
                                                                  IsChecked="{Binding IsChecked, Mode=OneWay}">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </CheckBox>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Style="{StaticResource CountButton}"
                                                                    Content="&#x2212;"
                                                                    Click="OnDecreaseClick" />
                                                            <TextBox Width="36"
                                                                     Margin="4,0"
                                                                     TextAlignment="Center"
                                                                     Style="{DynamicResource FieldTextBox}"
                                                                     Text="{Binding CountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button Style="{StaticResource CountButton}"
                                                                    Content="+"
                                                                    Click="OnIncreaseClick" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="4"
                    Padding="10"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding TemplatesHeader}" />
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               TextWrapping="Wrap"
                               Text="{Binding Text.SearchHint}"
                               Visibility="{Binding HasNoVisibleTemplates, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TemplateGroups}"
                                      PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <CheckBox Margin="0,5,0,2"
                                                  IsThreeState="True"
                                                  Style="{StaticResource TreeNode}"
                                                  IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                  Content="{Binding DisplayName}" />
                                        <ItemsControl ItemsSource="{Binding Children}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="16,1,0,1"
                                                          Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  Style="{StaticResource TreeNode}"
                                                                  IsChecked="{Binding IsChecked, Mode=OneWay}">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </CheckBox>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Style="{StaticResource CountButton}"
                                                                    Content="&#x2212;"
                                                                    Click="OnDecreaseClick" />
                                                            <TextBox Width="36"
                                                                     Margin="4,0"
                                                                     TextAlignment="Center"
                                                                     Style="{DynamicResource FieldTextBox}"
                                                                     Text="{Binding CountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button Style="{StaticResource CountButton}"
                                                                    Content="+"
                                                                    Click="OnIncreaseClick" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{DynamicResource CaptionText}"
                               Text="{Binding TemplateSection}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{DynamicResource CaptionText}"
                               TextWrapping="Wrap"
                               Text="{Binding TemplateHint}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBox Style="{DynamicResource FieldTextBox}"
                             Text="{Binding TemplateSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Margin="0,6,0,0"
                              MinHeight="26"
                              ItemsSource="{Binding TemplateChoices}"
                              SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,6"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding ReportCaption}" />
                <TextBox Style="{DynamicResource ReportTextBox}"
                         MinHeight="60"
                         MaxHeight="120"
                         Text="{Binding Report, Mode=OneWay}" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="5"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{DynamicResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Content="{Binding Text.Help}"
                    Click="OnHelpClick" />
            <Button Style="{DynamicResource PrimaryButton}"
                    Margin="0,0,8,0"
                    Content="{Binding DuplicateButtonText}"
                    Click="OnDuplicateClick" />
            <Button Style="{DynamicResource SecondaryButton}"
                    Content="{Binding Text.Close}"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
