<Window x:Class="ArKrPlugFR.Plugins.PileData.PileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="880"
        Height="700"
        MinWidth="700"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArKrPlugFR.Ui;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="ParamField" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
                <Setter Property="Margin" Value="0,4,0,10" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource TitleText}" Text="{Binding WindowTitle}" />
            <TextBlock Style="{DynamicResource CaptionText}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Margin="0,0,12,0"
                                Content="{Binding PickPilesText}"
                                Click="OnPickPilesClick" />
                        <TextBlock VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionText}"
                                   Text="{Binding PilesLine}" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding PilesCaption}" />

                    <ListBox ItemsSource="{Binding PileRows}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="12"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Margin="0,0,12,0"
                                Content="{Binding PickSlabsText}"
                                Click="OnPickSlabsClick" />
                        <TextBlock VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionText}"
                                   Text="{Binding SlabsLine}" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding SlabsCaption}" />

                    <ListBox ItemsSource="{Binding SlabRows}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{DynamicResource CaptionText}" Text="{Binding StartLabel}" />
                    <TextBox Width="90"
                             Margin="0,4,0,0"
                             HorizontalAlignment="Left"
                             Style="{DynamicResource FieldTextBox}"
                             Text="{Binding StartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Margin="0,10,0,0"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Content="{Binding TopDownText}"
                              IsChecked="{Binding TopDown, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{DynamicResource CaptionText}" Text="{Binding NumberParameterLabel}" />
                    <TextBox Style="{StaticResource ParamField}"
                             Text="{Binding NumberParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{DynamicResource CaptionText}" Text="{Binding CutParameterLabel}" />
                    <TextBox Style="{StaticResource ParamField}"
                             Text="{Binding CutParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Style="{DynamicResource CaptionText}" Text="{Binding SlabParameterLabel}" />
                    <TextBox Style="{StaticResource ParamField}"
                             Text="{Binding SlabParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{DynamicResource CaptionText}" Text="{Binding PileParameterLabel}" />
                    <TextBox Style="{StaticResource ParamField}"
                             Text="{Binding PileParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,6"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding ReportCaption}" />
                <TextBox Style="{DynamicResource ReportTextBox}"
                         MinHeight="64"
                         MaxHeight="160"
                         Text="{Binding Report, Mode=OneWay}" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{DynamicResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Content="{Binding NumberButtonText}"
                        Click="OnNumberClick" />
                <Button Style="{DynamicResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Content="{Binding ElevationsButtonText}"
                        Click="OnElevationsClick" />
                <Button Style="{DynamicResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Content="{Binding CutButtonText}"
                        Click="OnCutClick" />
                <Button Style="{DynamicResource SecondaryButton}"
                        Content="{Binding Text.Close}"
                        IsCancel="True"
                        Click="OnCloseClick" />
            </StackPanel>
            <TextBlock Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Style="{DynamicResource CaptionText}"
                       TextWrapping="Wrap"
                       Text="{Binding Hint}" />
        </DockPanel>
    </Grid>
</Window>
