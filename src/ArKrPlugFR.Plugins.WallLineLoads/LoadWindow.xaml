<Window x:Class="ArKrPlugFR.Plugins.WallLineLoads.LoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="660"
        Height="620"
        MinWidth="560"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArKrPlugFR.Ui;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource TitleText}"
                       Text="{Binding WindowTitle}" />
            <TextBlock Style="{DynamicResource CaptionText}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="12"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Style="{DynamicResource CaptionText}"
                           Text="{Binding ScopeLabel}" />
                <ComboBox Margin="0,4,0,0"
                          Width="280"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding Scopes}"
                          SelectedIndex="{Binding ScopeIndex, Mode=TwoWay}" />

                <TextBlock Margin="0,10,0,0"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding WorksetLabel}" />
                <ComboBox Margin="0,4,0,0"
                          Width="280"
                          HorizontalAlignment="Left"
                          IsEnabled="{Binding WorksetsEnabled}"
                          ItemsSource="{Binding WorksetNames}"
                          SelectedIndex="{Binding WorksetIndex, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding CaseLabel}" />
                <TextBox Grid.Row="1" Grid.Column="0"
                         Margin="0,4,0,0"
                         Style="{DynamicResource FieldTextBox}"
                         Text="{Binding CaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding CommentLabel}" />
                <TextBox Grid.Row="1" Grid.Column="2"
                         Margin="0,4,0,0"
                         Style="{DynamicResource FieldTextBox}"
                         Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Margin="0,12,0,0"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding ForceLabel}" />
                <TextBox Grid.Row="3" Grid.Column="0"
                         Margin="0,4,0,0"
                         Style="{DynamicResource FieldTextBox}"
                         Text="{Binding ForceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="2"
                           Margin="0,12,0,0"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding MomentLabel}" />
                <TextBox Grid.Row="3" Grid.Column="2"
                         Margin="0,4,0,0"
                         Style="{DynamicResource FieldTextBox}"
                         Text="{Binding MomentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <CheckBox Foreground="{DynamicResource TextPrimaryBrush}"
                          Content="{Binding UniformLabel}"
                          IsChecked="{Binding Uniform, Mode=TwoWay}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{DynamicResource CaptionText}"
                           TextWrapping="Wrap"
                           Text="{Binding CaseHint}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="10"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding ReportCaption}" />
                    <TextBox Style="{DynamicResource ReportTextBox}"
                             MinHeight="60"
                             Text="{Binding Report, Mode=OneWay}" />
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{DynamicResource PrimaryButton}"
                    Margin="0,0,8,0"
                    Content="{Binding ApplyText}"
                    Click="OnApplyClick" />
            <Button Style="{DynamicResource SecondaryButton}"
                    Content="{Binding Text.Close}"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
