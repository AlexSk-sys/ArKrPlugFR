<Window x:Class="ArKrPlugFR.Plugins.SplitFloors.SplitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="640"
        Height="560"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArKrPlugFR.Ui;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource TitleText}"
                       Text="{Binding WindowTitle}" />
            <TextBlock Style="{DynamicResource CaptionText}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="12"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{DynamicResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Content="{Binding PickFloorsText}"
                            Click="OnPickFloorsClick" />
                    <Button Style="{DynamicResource SecondaryButton}"
                            Content="{Binding ClearText}"
                            Click="OnClearClick" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,6"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding FloorsCaption}" />

                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,6,0,0"
                           Style="{DynamicResource CaptionText}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding FloorsLine}" />

                <ListBox ItemsSource="{Binding PickedFloors}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   Style="{DynamicResource CaptionText}"
                   TextWrapping="Wrap"
                   Text="{Binding OptionsHint}" />

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,6"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding ReportCaption}" />
                <TextBox Style="{DynamicResource ReportTextBox}"
                         MinHeight="64"
                         MaxHeight="150"
                         Text="{Binding Report, Mode=OneWay}" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{DynamicResource PrimaryButton}"
                    Margin="0,0,8,0"
                    Content="{Binding ApplyText}"
                    Click="OnApplyClick" />
            <Button Style="{DynamicResource SecondaryButton}"
                    Content="{Binding Text.Close}"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
