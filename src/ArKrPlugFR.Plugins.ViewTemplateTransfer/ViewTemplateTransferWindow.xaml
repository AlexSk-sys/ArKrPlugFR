<Window x:Class="ArKrPlugFR.Plugins.ViewTemplateTransfer.ViewTemplateTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ArKrPlugFR.Plugins.ViewTemplateTransfer"
        Title="{Binding WindowTitle}"
        Width="1100"
        Height="900"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArKrPlugFR.Ui;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TreeItem" TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="IsExpanded" Value="False" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TargetRow" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom caption: the window is borderless, so the title row also
                 carries the drag area, Help, Minimize and Close. -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceRaisedBrush}"
                  MouseLeftButtonDown="OnCaptionMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Style="{DynamicResource TitleText}"
                           Text="{Binding WindowTitle}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}"
                            Content="{Binding Text.Help}"
                            Click="OnHelpClick" />
                    <Button Style="{StaticResource CaptionButton}"
                            Content="—"
                            Click="OnMinimizeClick" />
                    <Button Style="{StaticResource CaptionButton}"
                            Content="✕"
                            Click="OnCloseCaptionClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left: the tree of transferable views. -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom"
                                   Margin="10,6,10,8"
                                   Style="{DynamicResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding Text.TreeHint}" />
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="10,8,10,0"
                                   Style="{DynamicResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding EmptyTreeNote}"
                                   Visibility="{Binding HasNoGroups, Converter={StaticResource BoolToVisibility}}" />
                        <TreeView x:Name="Tree"
                                  Margin="6"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  ItemsSource="{Binding Groups}"
                                  ItemContainerStyle="{StaticResource TreeItem}"
                                  PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:GroupNodeViewModel}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <CheckBox IsThreeState="True"
                                                  IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                  IsHitTestVisible="False"
                                                  Focusable="False"
                                                  VerticalAlignment="Center"
                                                  Content="{Binding DisplayName}" />
                                        <TextBlock Text="{Binding CountText, StringFormat=' ({0})'}"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource CaptionText}" />
                                    </StackPanel>
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:TemplateNodeViewModel}">
                                            <CheckBox Margin="34,2,0,2"
                                                      IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                      IsHitTestVisible="False"
                                                      Focusable="False"
                                                      VerticalAlignment="Center"
                                                      Content="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                </Border>

                <!-- Right: the source project and the transfer action. -->
                <Border Grid.Column="2"
                        VerticalAlignment="Top"
                        Padding="12"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding SourceLine}" />

                        <TextBlock Margin="0,16,0,0"
                                   Style="{DynamicResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding TargetsHeader}" />

                        <TextBlock Margin="0,6,0,0"
                                   Style="{DynamicResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding Text.NoTargetsHint}"
                                   Visibility="{Binding HasNoTargets, Converter={StaticResource BoolToVisibility}}" />

                        <ListBox Margin="0,6,0,0"
                                 MaxHeight="220"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding Targets}"
                                 SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                 DisplayMemberPath="Title"
                                 ItemContainerStyle="{StaticResource TargetRow}" />

                        <TextBlock Margin="0,10,0,0"
                                   Style="{DynamicResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Text="{Binding TargetLine}" />

                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{DynamicResource PrimaryButton}"
                                Content="{Binding TransferButtonText}"
                                Click="OnTransferClick" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom: the report of the last transfer, hidden while empty. -->
            <Border Grid.Row="2"
                    Margin="16,0,16,14"
                    Padding="10"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding ReportCaption}" />
                    <TextBox Style="{DynamicResource ReportTextBox}"
                             MinHeight="64"
                             MaxHeight="160"
                             Text="{Binding Report, Mode=OneWay}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
