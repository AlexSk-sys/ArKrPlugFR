<Window x:Class="ArKrPlugFR.Plugins.ScheduleHeaderText.HeaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="640"
        Height="560"
        MinWidth="540"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArKrPlugFR.Ui;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource TitleText}"
                       Text="{Binding WindowTitle}" />
            <TextBlock Style="{DynamicResource CaptionText}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="12"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding ScheduleLabel}" />
                <ComboBox Grid.Row="1" Grid.Column="0"
                          Margin="0,4,0,0"
                          ItemsSource="{Binding ScheduleNames}"
                          SelectedIndex="{Binding ScheduleIndex, Mode=TwoWay}" />

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding ParameterLabel}" />
                <ComboBox Grid.Row="1" Grid.Column="2"
                          Margin="0,4,0,0"
                          ItemsSource="{Binding ParameterNames}"
                          SelectedIndex="{Binding ParameterIndex, Mode=TwoWay}" />

                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                          Margin="0,12,0,0"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Content="{Binding FromElementsText}"
                          IsChecked="{Binding FromElements, Mode=TwoWay}" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Margin="0,12,0,0"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding ValueLabel}" />
                <TextBox Grid.Row="3" Grid.Column="2"
                         Margin="0,12,0,0"
                         Style="{DynamicResource FieldTextBox}"
                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="12"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Style="{DynamicResource CaptionText}"
                               TextWrapping="Wrap"
                               Text="{Binding RowLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="2"
                             Margin="0,4,0,0"
                             Style="{DynamicResource FieldTextBox}"
                             Text="{Binding Row, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="0" Grid.Column="4"
                               Style="{DynamicResource CaptionText}"
                               TextWrapping="Wrap"
                               Text="{Binding ColumnLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="4"
                             Margin="0,4,0,0"
                             Style="{DynamicResource FieldTextBox}"
                             Text="{Binding Column, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{DynamicResource CaptionText}"
                               TextWrapping="Wrap"
                               Text="{Binding BodyNote}" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="10"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,6"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding ReportCaption}" />
                    <TextBox Style="{DynamicResource ReportTextBox}"
                             MinHeight="60"
                             Text="{Binding Report, Mode=OneWay}" />
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{DynamicResource PrimaryButton}"
                    Margin="0,0,8,0"
                    Content="{Binding ApplyText}"
                    Click="OnApplyClick" />
            <Button Style="{DynamicResource SecondaryButton}"
                    Content="{Binding Text.Close}"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
