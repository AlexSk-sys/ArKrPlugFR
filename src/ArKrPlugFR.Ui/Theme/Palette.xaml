<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ArKrPlugFR palette. Dark, low-glare surface intended to sit next to Revit
        all day. The values are deliberately consolidated here: no colour is
        written inline in a view.
    -->

    <Color x:Key="SurfaceColor">#FF0D0F12</Color>
    <Color x:Key="SurfaceRaisedColor">#FF161A20</Color>
    <Color x:Key="SurfaceOverlayColor">#FF1F242C</Color>
    <Color x:Key="BorderColor">#FF2B323C</Color>
    <Color x:Key="AccentColor">#FF22D3EE</Color>
    <Color x:Key="AccentMutedColor">#FF0E7490</Color>
    <Color x:Key="TextPrimaryColor">#FFE6EBF2</Color>
    <Color x:Key="TextSecondaryColor">#FF9AA6B6</Color>
    <Color x:Key="DangerColor">#FFF87171</Color>
    <Color x:Key="WarningColor">#FFFBBF24</Color>
    <Color x:Key="SuccessColor">#FF4ADE80</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{StaticResource SurfaceOverlayColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="BodyFontSize">13</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="CaptionFontSize">11</system:Double>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="TitleFontSize">15</system:Double>

</ResourceDictionary>
