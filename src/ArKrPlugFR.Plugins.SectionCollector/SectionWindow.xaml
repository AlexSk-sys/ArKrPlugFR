<Window x:Class="ArKrPlugFR.Plugins.SectionCollector.SectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="640"
        Height="520"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArKrPlugFR.Ui;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource TitleText}"
                       Text="{Binding WindowTitle}" />
            <TextBlock Style="{DynamicResource CaptionText}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <TextBox Grid.Row="1"
                 Style="{DynamicResource ReportTextBox}"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 Text="{Binding Report, Mode=OneWay}" />

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center"
                       Style="{DynamicResource CaptionText}"
                       Text="{Binding Status}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Content="{Binding Text.SelectAll}"
                        Click="OnSelectAllClick" />
                <Button Style="{DynamicResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Content="{Binding Text.Copy}"
                        Click="OnCopyClick" />
                <Button Style="{DynamicResource SecondaryButton}"
                        Content="{Binding Text.Close}"
                        IsCancel="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
