<Window x:Class="ArKrPlugFR.Plugins.AssignWorksets.WorksetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="780"
        Height="580"
        MinWidth="640"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArKrPlugFR.Ui;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="RuleItem" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Padding" Value="8,3" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource TitleText}"
                       Text="{Binding WindowTitle}" />
            <TextBlock Style="{DynamicResource CaptionText}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="12"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding RulesCaption}" />

                <Grid DockPanel.Dock="Top" Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding KindCaption}" />
                    <TextBlock Grid.Column="1"
                               Margin="6,0"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding PatternCaption}" />
                    <TextBlock Grid.Column="2"
                               Margin="0,0,6,0"
                               Style="{DynamicResource CaptionText}"
                               Text="{Binding TargetCaption}" />
                </Grid>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left"
                            Style="{DynamicResource SecondaryButton}"
                            Content="{Binding AddRuleText}"
                            Click="OnAddRuleClick" />
                    <CheckBox Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Content="{Binding CreateMissingText}"
                              IsChecked="{Binding CreateMissingWorksets, Mode=TwoWay}" />
                </DockPanel>

                <ListBox ItemsSource="{Binding Rules}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource RuleItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding Kinds}"
                                          SelectedIndex="{Binding KindIndex, Mode=TwoWay}" />

                                <TextBox Grid.Column="1"
                                         Margin="6,0"
                                         VerticalAlignment="Center"
                                         Style="{DynamicResource FieldTextBox}"
                                         Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBox Grid.Column="2"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Style="{DynamicResource FieldTextBox}"
                                         IsEnabled="{Binding TargetEnabled}"
                                         Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Grid.Column="3"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource RemoveButton}"
                                        Content="{Binding RemoveText}"
                                        Click="OnRemoveRuleClick" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   Style="{DynamicResource CaptionText}"
                   TextWrapping="Wrap"
                   Text="{Binding KindHint}" />

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,6"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding ReportCaption}" />
                <TextBox Style="{DynamicResource ReportTextBox}"
                         MinHeight="64"
                         MaxHeight="150"
                         Text="{Binding Report, Mode=OneWay}" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Style="{DynamicResource PrimaryButton}"
                    Margin="0,0,8,0"
                    Content="{Binding ApplyText}"
                    Click="OnApplyClick" />
            <Button Style="{DynamicResource SecondaryButton}"
                    Content="{Binding Text.Close}"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
