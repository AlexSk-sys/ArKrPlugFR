<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ArKrPlugFR.Host</RootNamespace>
    <AssemblyName>ArKrPlugFR.Host</AssemblyName>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    The host is the entry point declared in ArKrPlugFR.addin. It builds the
    ribbon from the *.plugin.json manifests found next to its own assembly and
    hands each button the path of the tool assembly, so a tool can be added or
    removed without touching this project.
  -->

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArKrPlugFR.Core\ArKrPlugFR.Core.csproj" />
    <ProjectReference Include="..\ArKrPlugFR.Revit\ArKrPlugFR.Revit.csproj" />
    <ProjectReference Include="..\ArKrPlugFR.Ui\ArKrPlugFR.Ui.csproj" />
  </ItemGroup>

</Project>
