<Window x:Class="ArKrPlugFR.Plugins.SheetBrowser.SheetBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="720"
        Height="620"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ArKrPlugFR.Ui;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="BrowserRow" TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="1" />
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnRowRightClick" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Style="{DynamicResource TitleText}" Text="{Binding WindowTitle}" />
            <TextBlock Style="{DynamicResource CaptionText}"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Subtitle}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,4"
                   Style="{DynamicResource CaptionText}"
                   Text="{Binding Summary}" />

        <TextBlock Grid.Row="2"
                   Margin="0,0,0,4"
                   Style="{DynamicResource CaptionText}"
                   TextWrapping="Wrap"
                   Text="{Binding SchemeNote}"
                   Visibility="{Binding HasSchemeNote, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Row="3"
                Margin="0,6,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <TreeView ItemsSource="{Binding Nodes}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      ItemContainerStyle="{StaticResource BrowserRow}"
                      SelectedItemChanged="OnTreeSelectionChanged">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Text.CopyPath}" Click="OnCopyClick" />
                    </ContextMenu>
                </TreeView.ContextMenu>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Margin="0,1"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,6"
                           Style="{DynamicResource CaptionText}"
                           Text="{Binding ReportCaption}" />
                <TextBox Style="{DynamicResource ReportTextBox}"
                         MinHeight="48"
                         MaxHeight="120"
                         Text="{Binding Report, Mode=OneWay}" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right"
                    Style="{DynamicResource SecondaryButton}"
                    Content="{Binding Text.Close}"
                    IsCancel="True"
                    Click="OnCloseClick" />
            <Button DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    Style="{DynamicResource PrimaryButton}"
                    Content="{Binding CopyPathText}"
                    Click="OnCopyClick" />
            <TextBlock Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Style="{DynamicResource CaptionText}"
                       TextWrapping="Wrap"
                       Text="{Binding Hint}" />
        </DockPanel>
    </Grid>
</Window>
